<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="3dp" android:paddingHorizontal="2dp" android:paddingVertical="3dp"
    android:background="@drawable/widget_week_lesson_surface" android:orientation="vertical">
    <TextView android:id="@+id/week_widget_lesson_start" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="1"
        android:fontFamily="sans-serif-condensed" android:includeFontPadding="false"
        android:textColor="@color/focus_widget_muted" android:textSize="9sp" />
    <TextView android:id="@+id/week_widget_lesson_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end"
        android:includeFontPadding="false" android:textColor="@color/focus_widget_text"
        android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
