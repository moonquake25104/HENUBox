<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_surface"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_surface_soft" android:scaleType="fitXY"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/focus_widget_label"
            android:textColor="@color/focus_widget_muted"
            android:textSize="12sp" />
        <Chronometer
            android:id="@+id/focus_widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:textColor="@color/focus_widget_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/focus_widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:text="@string/focus_widget_preview_time"
            android:textColor="@color/focus_widget_text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/focus_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/focus_widget_preview_status"
            android:textColor="@color/focus_widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
